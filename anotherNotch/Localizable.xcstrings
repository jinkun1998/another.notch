            "state": "translated",
            "value": "Activar acceso de accesibilidad"
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Activer l'accès à l'accessibilité"
          }
        }
      }
    },
    "Accessibility access allows anotherNotch to replace macOS volume and brightness HUDs with dynamic notch overlays.": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Accessibility access allows anotherNotch to replace macOS volume and brightness HUDs with dynamic notch overlays."
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Quyền Trợ năng cho phép anotherNotch thay thế các HUD âm lượng và độ sáng macOS bằng giao diện notch sinh động."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "辅助功能权限允许 anotherNotch 用动态刘海浮层替换 macOS 音量和亮度 HUD。"
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "El acceso de accesibilidad permite a anotherNotch reemplazar los HUD de volumen y brillo de macOS con superposiciones dinámicas."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "L'accès à l'accessibilité permet à anotherNotch de remplacer les HUD macOS par des incrustations dynamiques dans l'encoche."
          }
        }
      }
    },
    "Used solely for hardware key HUD indicators. No keystrokes or private data are recorded.": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Used solely for hardware key HUD indicators. No keystrokes or private data are recorded."
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Chỉ dùng cho các chỉ báo HUD phím phần cứng. Không ghi lại bất kỳ phím gõ hoặc dữ liệu riêng tư nào."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "仅用于硬件按键 HUD 指示器。绝不记录按键或任何个人隐私数据。"
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Se utiliza únicamente para los indicadores de teclas de hardware. No se registran pulsaciones ni datos privados."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Utilisé uniquement pour les indicateurs de touches matérielles. Aucune frappe ni donnée privée n'est enregistrée."
          }
        }
      }
    },
    "Enable Bluetooth Accessories": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Enable Bluetooth Accessories"
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Bật phụ kiện Bluetooth"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "启用蓝牙配件"
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Activar accesorios Bluetooth"
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Activer les accessoires Bluetooth"
          }
        }
      }
    },
    "anotherNotch can show when your Bluetooth audio accessories connect, including their battery level when available.": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "anotherNotch can show when your Bluetooth audio accessories connect, including their battery level when available."
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "anotherNotch có thể hiển thị khi phụ kiện âm thanh Bluetooth kết nối, bao gồm mức pin khi khả dụng."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "anotherNotch 可以在蓝牙音频配件连接时提示，并在可用时显示其电量。"
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "anotherNotch puede mostrar cuándo se conectan tus accesorios Bluetooth, incluyendo su batería si está disponible."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "anotherNotch peut afficher la connexion de vos accessoires Bluetooth, y compris leur niveau de batterie."
          }
        }
      }
    },
    "Bluetooth access is used only for connected accessory notifications.": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Bluetooth access is used only for connected accessory notifications."
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Quyền truy cập Bluetooth chỉ dùng cho các thông báo phụ kiện được kết nối."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "蓝牙访问仅用于已连接配件的通知。"
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "El acceso a Bluetooth se usa únicamente para notificaciones de accesorios conectados."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "L'accès Bluetooth est utilisé uniquement pour les notifications des accessoires connectés."
          }
        }
      }
    },
    "Works with most media apps, including browsers, to detect what's playing. Note: This may be removed in a future macOS version.": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Works with most media apps, including browsers, to detect what's playing. Note: This may be removed in a future macOS version."
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Hoạt động với hầu hết các ứng dụng đa phương tiện, bao gồm trình duyệt. Lưu ý: Tính năng này có thể bị loại bỏ trong phiên bản macOS tương lai."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "兼容大多数媒体播放器和浏览器以检测播放内容。注意：此功能可能在未来的 macOS 版本中移除。"
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Funciona con la mayoría de apps multimedia y navegadores. Nota: Podría eliminarse en versiones futuras de macOS."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Fonctionne avec la plupart des applications multimédias et navigateurs. Remarque : Peut être retiré dans une future version de macOS."
          }
        }
      }
    },
