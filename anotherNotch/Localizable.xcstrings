    "Auto mode allows macOS thermal algorithms to manage fan speeds normally. Manual mode applies target RPMs within hardware-safe bounds.": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Auto mode allows macOS thermal algorithms to manage fan speeds normally. Manual mode applies target RPMs within hardware-safe bounds."
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Chế độ tự động cho phép thuật toán nhiệt của macOS quản lý tốc độ quạt bình thường. Chế độ thủ công áp dụng RPM mục tiêu trong giới hạn an toàn phần cứng."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "自动模式允许 macOS 热量算法正常管理风扇转速。手动模式在硬件安全范围内应用目标 RPM。"
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "El modo automático permite a macOS gestionar la velocidad de los ventiladores con normalidad. El modo manual aplica RPM objetivo dentro de límites seguros."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Le mode automatique permet aux algorithmes thermiques de macOS de gérer les ventilateurs. Le mode manuel applique des RPM cibles dans les limites de sécurité."
          }
        }
      }
    },
    "Manual Control": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Manual Control"
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Điều khiển thủ công"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "手动控制"
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Control manual"
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Contrôle manuel"
          }
        }
      }
    },
    "Restore macOS Auto Mode": {
      "localizations": {
        "en": {
