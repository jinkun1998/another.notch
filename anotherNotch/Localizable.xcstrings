            "value": "Rétablir le mode automatique de macOS"
          }
        }
      }
    },
    "Direct SMC speed writes require administrative privileges. System remains safely in Auto mode.": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Direct SMC speed writes require administrative privileges. System remains safely in Auto mode."
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Ghi trực tiếp tốc độ vào SMC yêu cầu quyền quản trị. Hệ thống vẫn ở chế độ Tự động an toàn."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "直接向 SMC 写入转速需要管理员权限。系统将安全保持在自动模式。"
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Escribir directamente la velocidad en el SMC requiere privilegios de administrador. El sistema permanece de forma segura en modo Automático."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "L'écriture directe de vitesse dans le SMC nécessite des privilèges d'administrateur. Le système reste en sécurité en mode automatique."
          }
        }
      }
    },
    "Show fan telemetry and cooling controls in the notch.": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Show fan telemetry and cooling controls in the notch."
          }
        },
        "vi": {
