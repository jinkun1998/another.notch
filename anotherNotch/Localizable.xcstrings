    "Enable Accessibility Access": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Enable Accessibility Access"
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Bật quyền Trợ năng"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "启用辅助功能访问权限"
          }
        },
        "es": {
