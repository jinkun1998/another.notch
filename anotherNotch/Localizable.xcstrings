    "The helper is a small setuid binary installed to /usr/local/bin/smc-helper. It requires administrator password once. On Apple Silicon, SIP must also be disabled for fan writes to succeed." : {
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "The helper is a small setuid binary installed to /usr/local/bin/smc-helper. It requires administrator password once. On Apple Silicon, SIP must also be disabled for fan writes to succeed."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "new",
